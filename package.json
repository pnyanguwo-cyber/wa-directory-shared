{
  "name": "@wa-directory/shared",
  "version": "1.0.0",
  "description": "Shared libraries for WA Directory webapp and chatbot",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./lib/*": {
      "import": "./dist/lib/*.mjs",
      "require": "./dist/lib/*.js",
      "types": "./dist/lib/*.d.ts"
    },
    "./data/*": {
      "import": "./dist/data/*.mjs",
      "require": "./dist/data/*.js",
      "types": "./dist/data/*.d.ts"
    },
    "./types/*": {
      "import": "./dist/types/*.mjs",
      "require": "./dist/types/*.js",
      "types": "./dist/types/*.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "prepare": "tsc",
    "build:watch": "tsc --watch",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "keywords": [
    "wa-directory",
    "shared",
    "typescript"
  ],
  "author": "WA Directory Team",
  "license": "MIT",
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "lucide-react": "^1.33.0",
    "next": "^14.2.0",
    "react": "^18.3.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.31",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
